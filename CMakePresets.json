{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/out/build-fetch/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "",
                "VCPKG_TARGET_TRIPLET": "",
                "FETCHCONTENT_BASE_DIR": "${sourceDir}/work/fetchcontent"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "windows-base",
            "architecture": "x64"
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug"
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release",
            "configuration": "Release"
        }
    ]
}
